# ------------------------------------------------------------------
# 이 파일은 "예시"입니다. 실제 값은 .env 파일에 넣으세요 (.env는 GitHub에 올라가지 않습니다).
# 로컬: 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채웁니다.
# Vercel: 아래 6개를 Settings > Environment Variables 에 하나씩 등록합니다.
# ------------------------------------------------------------------

# [1] DATABASE_URL — 앱이 평소에 쓰는 연결 주소 (Connection Pooling / 포트 6543)
# 복사 위치: Supabase 대시보드 > 프로젝트 선택 > 상단 [Connect] 버튼
#            > "Connection string" 탭 > Type = "Transaction pooler" 선택 > 주소 복사
# 주의 1) 주소 안의 [YOUR-PASSWORD] 를 프로젝트 만들 때 정한 DB 비밀번호로 바꾸세요.
# 주의 2) 주소 끝에 ?pgbouncer=true&connection_limit=1 을 반드시 붙이세요.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# [2] DIRECT_URL — 표(테이블)를 만들 때만 쓰는 직접 연결 주소 (포트 5432)
# 복사 위치: 같은 [Connect] 창 > Type = "Session pooler" 또는 "Direct connection" 선택 > 주소 복사
# (포트가 5432 인 주소여야 합니다. 여기에는 ?pgbouncer=... 를 붙이지 마세요.)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# [3] AUTH_SECRET — 로그인 세션(쿠키)을 암호화하는 비밀 키
# 만드는 법: 터미널에서  npx auth secret  실행하면 자동 생성됩니다.
#            또는 아무 랜덤 문자열 32자 이상.
AUTH_SECRET="여기에-랜덤한-긴-문자열"

# [4] NEXTAUTH_URL — 사이트 주소
# 로컬:  http://localhost:3000
# Vercel: https://내프로젝트이름.vercel.app  (배포 후 Vercel 화면 상단에 뜨는 주소)
NEXTAUTH_URL="http://localhost:3000"

# [5][6] 최초 어드민 계정 — 시드(초기 데이터) 스크립트가 이 값으로 계정을 만듭니다.
INITIAL_ADMIN_ID="admin"
INITIAL_ADMIN_PASSWORD="Admin!2026"
